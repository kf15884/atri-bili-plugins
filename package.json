{
  "name": "atri-bili-library",
  "version": "2.0.0",
  "private": true,
  "description": "Atri B站双插件干净源码库",
  "workspaces": [
    "packages/atri-bilibili",
    "packages/atri-bili-eyes"
  ],
  "scripts": {
    "test": "node --require ./qa/network-guard.cjs --test packages/atri-bilibili/test/*.test.cjs packages/atri-bili-eyes/test/*.test.cjs",
